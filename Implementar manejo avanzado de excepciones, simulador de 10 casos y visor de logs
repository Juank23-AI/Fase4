        ]

        exitosas = 0
        fallidas = 0

        for nombre_caso, funcion in casos:
            try:
                funcion()
            except SistemaFJError as e:
                fallidas += 1
                logging.warning(f"[Simulación - {nombre_caso}] Error controlado: {type(e).__name__} -> {e}")
