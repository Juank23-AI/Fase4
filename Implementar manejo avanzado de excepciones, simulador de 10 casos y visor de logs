            f"• Exitosas: {exitosas}\n"
            f"• Fallidas controladas en log: {fallidas}",
        )

    def _abrir_visor_logs(self):
        """Lee el archivo app_errors.log usando try/except/else/finally y lo muestra en pantalla."""
        archivo = None
        try:
            archivo = open("app_errors.log", "r", encoding="utf-8")
            contenido = archivo.read()
        except FileNotFoundError as err:
            logging.error(f"Archivo de logs no encontrado: {err}")
            messagebox.showerror("Error", "Aún no existe el archivo 'app_errors.log'.")
        except OSError as err:
            logging.error(f"Error leyendo archivo de logs: {err}")
            messagebox.showerror("Error", f"No se pudo abrir el archivo de logs: {err}")
        else:
            ventana_logs = tk.Toplevel(self.root)
            ventana_logs.title("Auditoría del Sistema - app_errors.log")
            ventana_logs.geometry("720x400")

            texto_log = tk.Text(ventana_logs, wrap=tk.WORD, bg="#0f172a", fg="#e2e8f0", font=("Consolas", 9))
            texto_log.insert(tk.END, contenido if contenido else "Sin registros aún.")
            texto_log.config(state=tk.DISABLED)
            texto_log.pack(fill=tk.BOTH, expand=True, padx=10, pady=10)
        finally:
            if archivo and not archivo.closed:
                archivo.close()


