    def _guardar_reserva(self):
        """Bloque Try/Except para capturar errores, crear objetos y guardarlos permanentemente en memoria."""
        try:
            nombre_cliente = self.entry_cliente_nombre.get()
            doc_cliente = self.entry_cliente_doc.get()
            cliente_obj = (
                Cliente(self.contador_id, nombre_cliente, doc_cliente)
                if nombre_cliente or doc_cliente
                else None
            )

            tipo_servicio = self.combo_servicio.get()
            val1 = self.entry_detalle_1.get()
            val2 = self.entry_detalle_2.get()

            if not val1 or not val2:
                raise ValidacionError("Todos los campos del servicio son obligatorios.")

            if tipo_servicio == "Reserva de Sala":
                if not val2.isdigit():
                    raise ValidacionError("Las horas deben ser un número entero.")
                servicio_obj = ReservaSala(numero_sala=val1, horas=int(val2))

            elif tipo_servicio == "Alquiler de Equipos":
                if not val2.isdigit():
                    raise ValidacionError("La cantidad debe ser un número entero.")
                servicio_obj = AlquilerEquipos(tipo_equipo=val1, cantidad=int(val2))

            elif tipo_servicio == "Asesoría Especializada":
                if not val2.isdigit():
                    raise ValidacionError("Las horas deben ser un número entero.")
                servicio_obj = AsesoriaEspecializada(area=val1, horas_asesoria=int(val2))

            reserva = Reserva(self.contador_id, servicio_obj, cliente_obj)
            self.lista_reservas.append(reserva)
            self.contador_id += 1

            logging.info(f"Reserva #{reserva.id_entidad} guardada con éxito para: {reserva.cliente}")
            self._refrescar_tabla()
            messagebox.showinfo(
                "Éxito",
                f"Reserva #{reserva.id_entidad} registrada y guardada exitosamente.",
            )

        except (ValidacionError, ReservaError) as e:
            logging.warning(f"Error de validación/negocio al guardar reserva: {e}")
            messagebox.showerror("Error de Datos", str(e))
        except Exception as e:
            logging.error(f"Error inesperado del sistema: {e}", exc_info=True)
            messagebox.showerror("Error Crítico", f"Ocurrió un error: {e}")

    def _refrescar_tabla(self):
        """Limpia la tabla visual y vuelve a cargar todos los objetos de la lista en memoria."""
        for row in self.tree.get_children():
            self.tree.delete(row)

        for res in self.lista_reservas:
            self.tree.insert(
                "",
                tk.END,
                values=(
                    res.id_entidad,
                    str(res.cliente),
                    res.servicio.nombre_servicio,
                    res.servicio.obtener_descripcion(),
                    f"${res.costo_total:,.2f}",
                    res.estado,
                ),
            )

    def _cerrar_reserva(self):
        """Busca la reserva seleccionada en la tabla y la marca como cerrada."""
        seleccion = self.tree.selection()
        if not seleccion:
            messagebox.showwarning("Advertencia", "Por favor seleccione una reserva de la lista.")
            return

        item = self.tree.item(seleccion)
        reserva_id = item["values"][0]

        try:
            reserva = next(
                (r for r in self.lista_reservas if r.id_entidad == reserva_id),
                None,
            )
            if reserva:
                reserva.cerrar_reserva()
                logging.info(f"Reserva #{reserva_id} fue cerrada.")
                self._refrescar_tabla()
                messagebox.showinfo(
                    "Reserva Cerrada",
                    f"La reserva #{reserva_id} ha sido finalizada correctamente.",
                )
        except ReservaError as e:
            logging.warning(f"Error al cerrar la reserva #{reserva_id}: {e}")
            messagebox.showerror("Error", str(e))
        except Exception as e:
            logging.error(f"Error inesperado al cerrar reserva: {e}")
            messagebox.showerror("Error", f"No se pudo cerrar la reserva: {e}")

    def _registrar_con_auditoria(self, nombre_cliente: str, doc_cliente: str, tipo_servicio: str, val1: str, val2_str: str):
        """Registra una reserva usando try/except/else/finally y encadenamiento de excepciones."""
        exito = False
        try:
            if nombre_cliente and any(c.isdigit() for c in nombre_cliente):
                raise ValidacionError("El nombre del cliente no debe contener números.")
            if doc_cliente and not doc_cliente.strip().isdigit():
                raise ValidacionError("El documento del cliente debe ser numérico.")

            cliente_obj = (
                Cliente(self.contador_id, nombre_cliente, doc_cliente)
                if nombre_cliente or doc_cliente
                else None
            )

            if not val1 or not val2_str:
                raise ValidacionError("Todos los campos del servicio son obligatorios.")
            if not val2_str.isdigit():
                raise ValidacionError("Las horas o cantidad deben ser un número entero.")

            cantidad = int(val2_str)

            if tipo_servicio == "Reserva de Sala":
                if val1.strip() == "Sala VIP-99":
                    raise ServicioNoDisponibleError("La 'Sala VIP-99' no se encuentra disponible.")
                servicio_obj = ReservaSala(numero_sala=val1, horas=cantidad)
            elif tipo_servicio == "Alquiler de Equipos":
                if val1.strip() == "Estación de Trabajo":
                    raise ServicioNoDisponibleError("El equipo 'Estación de Trabajo' no tiene stock.")
                servicio_obj = AlquilerEquipos(tipo_equipo=val1, cantidad=cantidad)
            elif tipo_servicio == "Asesoría Especializada":
                servicio_obj = AsesoriaEspecializada(area=val1, horas_asesoria=cantidad)
            else:
                raise ValidacionError("Tipo de servicio no válido.")

            reserva = Reserva(self.contador_id, servicio_obj, cliente_obj)
        except ValidacionError as err:
            raise ReservaError(f"Error de validación en reserva: {err}") from err
        else:
            self.lista_reservas.append(reserva)
            self.contador_id += 1
            exito = True
            logging.info(f"Reserva #{reserva.id_entidad} registrada para: {reserva.cliente}")
            return reserva
        finally:
            logging.info(f"[Auditoría Finally] Registro finalizado -> {'EXITOSO' if exito else 'FALLIDO'}")

    def _ejecutar_simulaciones(self):
        """Simula 10 operaciones (válidas e inválidas) sin detener la aplicación."""
        logging.info("=== INICIO SIMULACIÓN DE 10 OPERACIONES ===")
        casos = [
            ("1. Válida - Sala", lambda: self._registrar_con_auditoria("Carlos Pérez", "10987654", "Reserva de Sala", "Sala A-101", "3")),
            ("2. Válida - Cliente Anónimo", lambda: self._registrar_con_auditoria("", "", "Alquiler de Equipos", "Portátil Core i7", "2")),
            ("3. Inválida - Documento con letras", lambda: self._registrar_con_auditoria("Ana Gómez", "ABC123", "Reserva de Sala", "Sala B-102", "2")),
            ("4. Inválida - Sala ocupada", lambda: self._registrar_con_auditoria("Luis Mora", "11223344", "Reserva de Sala", "Sala VIP-99", "2")),
            ("5. Válida - Asesoría", lambda: self._registrar_con_auditoria("Marta Díaz", "55667788", "Asesoría Especializada", "Redes", "4")),
            ("6. Inválida - Equipo agotado", lambda: self._registrar_con_auditoria("Pedro Ruiz", "99887766", "Alquiler de Equipos", "Estación de Trabajo", "1")),
